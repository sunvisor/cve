# ---- NVD API ----
# NVD API key. Optional but strongly recommended: it raises the rate limit
# from 5 to 50 requests / 30s. Get one free at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ---- Polling ----
# How often to poll NVD for new/updated CVEs (minutes).
POLL_INTERVAL_MINUTES=60
# On the very first run the DB is seeded with CVEs modified in the last N days
# WITHOUT sending notifications (to avoid an initial flood).
INITIAL_LOOKBACK_DAYS=7

# ---- Notifications ----
# Set the webhook URLs you actually use; leave the others empty.
SLACK_WEBHOOK_URL=
GOOGLE_CHAT_WEBHOOK_URL=
# Only notify for CVEs at or above this CVSS base score (0 = notify everything).
NOTIFY_MIN_CVSS=0.0

# Public URL of this app, used to build "管理画面" links in notifications.
PUBLIC_BASE_URL=http://localhost:8000

# ---- Watches ----
# Default keywords seeded into the DB on first run (comma separated).
# After first run, manage keywords from the web UI; this value is ignored for
# keywords that already exist.
DEFAULT_WATCHES=linux kernel,php,symfony,postgresql,nginx

# ---- Storage ----
DATABASE_URL=sqlite:///./data/cve.db
